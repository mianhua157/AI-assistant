# DashScope API key
# Get one from: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=sk-your-api-key-here

# Optional: point to a local SentenceTransformer model directory when running offline.
# Example:
# EMBEDDING_MODEL_PATH=C:\Users\yourname\.cache\huggingface\hub\models--sentence-transformers--all-MiniLM-L6-v2\snapshots\<snapshot-id>
EMBEDDING_MODEL_PATH=
